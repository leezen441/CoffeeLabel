# Postgres connection string.
#
# On Vercel: add a Postgres store (Storage -> Create Database -> Neon) and this
# variable is injected automatically — you do not need to set it by hand.
#
# Locally: copy this file to `.env.local` and paste a connection string.
# Without it the app still runs and saves labels in the browser's localStorage.
#
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Reading a bag label from a photo (the "Scan a bag" button).
#
# Without it the button reports that scanning is not set up; everything else
# works. On Vercel: Settings -> Environment Variables.
#
# ANTHROPIC_API_KEY="sk-ant-..."
#
# Which model reads the photo. The default is Claude Haiku 5.5, a fraction of
# a baht per scan. Set this to claude-opus-5-5 if handwritten dates or dim
# tins come back wrong — it costs roughly thirty times as much per scan.
#
# SCAN_MODEL="claude-haiku-5-5"
